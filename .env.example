# ==============================================================================
# VERTEXT POS — ENTERPRISE SUPERMARKET SAAS CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# SUPABASE REALTIME CLOUD INTEGRATION
# Add these in Netlify Environment Variables or local .env
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# SUPER ADMIN IDENTITY (Strict Auto-Elevation)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=sammyseth260@gmail.com

# ------------------------------------------------------------------------------
# SAFARICOM M-PESA DARAJA 2.0 (Global Sandbox Fallback)
# Note: In Vertext POS, each tenant supermarket can have their own Till/Shortcode 
# configured directly in the Super Admin Dashboard (/api/hierarchy/configure-daraja)
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_global_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_global_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-domain.netlify.app/api/mpesa/callback

# ------------------------------------------------------------------------------
# KRA eTIMS COMPLIANCE SETTINGS
# ------------------------------------------------------------------------------
ETIMS_ENV=sandbox
ETIMS_DEFAULT_PIN=P051234567Z

